{
  "name": "zhijian-markdown-editor",
  "productName": "纸间",
  "version": "1.1.0",
  "private": true,
  "description": "纸间 — 本地优先的中文 Markdown 编辑器",
  "author": "AlexRaganhar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexRaganhar/zhijian.git"
  },
  "homepage": "https://github.com/AlexRaganhar/zhijian",
  "bugs": {
    "url": "https://github.com/AlexRaganhar/zhijian/issues"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "tsc --noEmit && vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@milkdown/crepe": "7.22.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "dompurify": "3.4.17",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "1.59.0",
    "marked": "18.1.1",
    "marked-highlight": "^2.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.4"
  }
}
